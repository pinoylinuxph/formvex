{% if branding.logoUrl %}
    <img class="fv-brand-logo" src="{{ branding.logoUrl }}" alt="" width="32" height="32">
{% else %}
    <span class="fv-brand-mark" aria-hidden="true">{{ branding.brandMark }}</span>
{% endif %}
<span class="fv-brand-copy">
    <span class="fv-brand-wordmark">{{ branding.brandName }}</span>
    {% if branding.sloganVisible %}<span class="fv-brand-slogan">{{ branding.slogan }}</span>{% endif %}
</span>
