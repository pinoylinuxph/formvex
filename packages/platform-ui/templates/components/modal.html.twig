<section class="fv-modal" id="{{ modalId }}" role="dialog" aria-modal="true" aria-labelledby="{{ modalId }}-title" hidden>
    <div class="fv-modal-panel">
        <header class="fv-modal-header">
            <h2 id="{{ modalId }}-title">{{ title }}</h2>
            <button class="fv-icon-button" type="button" data-modal-close aria-label="Close dialog">×</button>
        </header>
        {% if description is defined %}
            <p class="fv-modal-description">{{ description }}</p>
        {% endif %}
        <div class="fv-modal-body">
            {% block modal_body %}{% endblock %}
        </div>
        <footer class="fv-modal-footer">
            {% block modal_footer %}{% endblock %}
        </footer>
    </div>
</section>
