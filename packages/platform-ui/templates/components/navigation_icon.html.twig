{% set iconName = name|default('dashboard') %}
<span class="fv-nav-icon" data-icon="{{ iconName }}" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
        {% if iconName == 'forms' %}
            <path d="M6 3h8l4 4v14H6z" />
            <path d="M14 3v5h5" />
            <path d="M9 13h6" />
            <path d="M9 17h6" />
        {% elseif iconName == 'submissions' %}
            <path d="M5 5h14v8H5z" />
            <path d="M3 13h5l2 3h4l2-3h5" />
            <path d="M3 13v6h18v-6" />
        {% elseif iconName == 'delivery' %}
            <path d="m21 3-7.5 18-3.5-8-8-3.5z" />
            <path d="M21 3 10 13" />
        {% elseif iconName == 'diagnostics' %}
            <path d="M3 12h4l2-6 4 12 2-6h6" />
        {% elseif iconName == 'maintenance' %}
            <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18a2 2 0 0 0 3 3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.8 2.8-3-3z" />
        {% elseif iconName == 'settings' %}
            <path d="M4 6h16" />
            <path d="M4 12h16" />
            <path d="M4 18h16" />
            <circle cx="9" cy="6" r="2" />
            <circle cx="15" cy="12" r="2" />
            <circle cx="11" cy="18" r="2" />
        {% else %}
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
        {% endif %}
    </svg>
</span>
