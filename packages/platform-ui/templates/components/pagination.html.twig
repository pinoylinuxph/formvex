{% set pageItems = pages|default([]) %}
{% if pageItems is not empty %}
    <nav class="fv-pagination" aria-label="{{ ariaLabel|default('Pagination') }}">
        {% if pageSizeControl is defined and pageSizeControl is not null %}
            <form class="fv-pagination-size" method="get" action="{{ pageSizeControl.action }}">
                {% for hidden in pageSizeControl.hidden|default([]) %}
                    <input type="hidden" name="{{ hidden.name }}" value="{{ hidden.value }}">
                {% endfor %}
                <label for="{{ pageSizeControl.id }}">{{ pageSizeControl.label|default('Rows per page') }}</label>
                <select class="fv-input" id="{{ pageSizeControl.id }}" name="{{ pageSizeControl.name }}">
                    {% for option in pageSizeControl.options %}
                        <option value="{{ option }}"{% if pageSizeControl.value == option %} selected{% endif %}>{{ option }}</option>
                    {% endfor %}
                </select>
                <button class="fv-button fv-button-secondary fv-button-small" type="submit">Apply</button>
            </form>
        {% endif %}
        <div class="fv-pagination-controls">
            <span class="fv-pagination-summary">Page {{ currentPage|default(1) }} of {{ pageCount|default(1) }}</span>
            {% if previous is defined and previous is not null %}
                {% if previous.disabled|default(false) %}
                    <span class="fv-pagination-link fv-pagination-disabled" aria-disabled="true">Previous</span>
                {% else %}
                    <a class="fv-pagination-link" href="{{ previous.href }}" rel="prev" aria-label="Previous page">Previous</a>
                {% endif %}
            {% endif %}

            <div class="fv-pagination-pages" aria-label="Page selection">
                {% for page in pageItems %}
                    {% if page.current %}
                        <span class="fv-pagination-link fv-pagination-current" aria-current="page">{{ page.page }}</span>
                    {% else %}
                        <a class="fv-pagination-link" href="{{ page.href }}" aria-label="Page {{ page.page }}">{{ page.page }}</a>
                    {% endif %}
                {% endfor %}
            </div>

            {% if next is defined and next is not null %}
                {% if next.disabled|default(false) %}
                    <span class="fv-pagination-link fv-pagination-disabled" aria-disabled="true">Next</span>
                {% else %}
                    <a class="fv-pagination-link" href="{{ next.href }}" rel="next" aria-label="Next page">Next</a>
                {% endif %}
            {% endif %}
        </div>
    </nav>
{% endif %}
