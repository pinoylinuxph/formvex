{% extends 'administration/portal_layout.html.twig' %}

{% block title %}Settings · {{ branding.brandName }}{% endblock %}

{% block content %}
<div class="fv-page">
    <nav class="fv-breadcrumbs" aria-label="Breadcrumbs">
        <a href="{{ path('spoke_admin_home') }}">Overview</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Settings</span>
    </nav>

    {% include '@platform_ui/components/page_header.html.twig' with {
        pageTitle: pageTitle,
        pageDescription: pageDescription,
    } only %}

    {% include '@platform_ui/components/feedback.html.twig' with {
        message: message,
        title: messageVariant == 'success' ? 'Saved' : 'Settings notice',
        variant: messageVariant,
    } only %}

    <section class="fv-panel fv-settings-summary" aria-labelledby="settings-status-heading">
        <div class="fv-settings-summary-heading">
            <div>
                <p class="fv-eyebrow">Configuration status</p>
                <h2 id="settings-status-heading">Local installation readiness</h2>
            </div>
            <p>Review the current delivery and protection state before changing a setting.</p>
        </div>
        <div class="fv-settings-status-grid">
            <div class="fv-settings-status-item">
                <span class="fv-settings-status-label">SMTP delivery</span>
                {% if settings.smtpReady and settings.testState.status.value == 'passed' and settings.testState.testedRevision == settings.settings.smtpConfigurationRevision %}
                    <strong class="fv-settings-status fv-settings-status-success">Ready and tested</strong>
                {% elseif settings.smtpReady %}
                    <strong class="fv-settings-status fv-settings-status-warning">Test required</strong>
                {% else %}
                    <strong class="fv-settings-status fv-settings-status-muted">Not configured</strong>
                {% endif %}
            </div>
            <div class="fv-settings-status-item">
                <span class="fv-settings-status-label">CAPTCHA protection</span>
                {% if abuseSettings.outageState.open %}
                    <strong class="fv-settings-status fv-settings-status-danger">Provider unavailable</strong>
                {% elseif abuseSettings.turnstileSecretConfigured %}
                    <strong class="fv-settings-status fv-settings-status-success">Available when enabled</strong>
                {% else %}
                    <strong class="fv-settings-status fv-settings-status-muted">Optional and not configured</strong>
                {% endif %}
            </div>
        </div>
    </section>

    <nav class="fv-settings-tabs" aria-label="Settings sections">
        {% for tab in settingsTabs %}
            <a class="fv-settings-tab{% if activeTab == tab.id %} fv-settings-tab-active{% endif %}" href="{{ path('spoke_admin_settings', {tab: tab.id}) }}"{% if activeTab == tab.id %} aria-current="page"{% endif %}>
                <span>{{ tab.label }}</span>
                <small>{{ tab.description }}</small>
            </a>
        {% endfor %}
    </nav>

    {% if activeTab == 'website' %}
    <section class="fv-panel fv-settings-panel" aria-labelledby="branding-heading">
        <header class="fv-section-heading">
            <p class="fv-eyebrow">Installation branding</p>
            <h2 id="branding-heading">Define the presentation identity</h2>
            <p>Choose the name, optional slogan, logo, and favicon shown by this local administration portal. These settings do not modify the customer website.</p>
        </header>
        <form class="fv-form" method="post" enctype="multipart/form-data" action="{{ path('spoke_admin_settings_branding_update', {tab: 'website'}) }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <div class="fv-settings-grid">
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'brand-name',
                    name: 'brand_name',
                    label: 'Brand name',
                    value: formData.brand_name,
                    maxlength: 80,
                    help: 'Required. Plain text up to 80 characters. Default: Noname.',
                    error: fieldErrors.brand_name|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'company-slogan',
                    name: 'slogan',
                    label: 'Company slogan (optional)',
                    value: formData.slogan,
                    maxlength: 160,
                    help: 'Plain text up to 160 characters.',
                    error: fieldErrors.slogan|default(null),
                } only %}
            </div>
            <label class="fv-checkbox" for="show-slogan">
                <input id="show-slogan" name="show_slogan" type="checkbox" value="1"{% if formData.show_slogan == '1' %} checked{% endif %}>
                <span>Display the slogan on sign-in, logout, and the administration shell</span>
            </label>
            {% if fieldErrors.branding_switch|default(null) %}<p class="fv-field-error" role="alert">{{ fieldErrors.branding_switch }}</p>{% endif %}
            <div class="fv-settings-grid">
                <div class="fv-field">
                    <label for="branding-logo">Logo</label>
                    <input class="fv-input" id="branding-logo" name="logo" type="file" accept="image/png,image/jpeg,image/svg+xml,.png,.jpg,.jpeg,.svg">
                    <p class="fv-field-help">PNG, JPEG, or static SVG. Maximum 2 MiB and 2,000 × 1,000 pixels.</p>
                    {% if branding.logoUrl %}
                        <div class="fv-branding-preview"><img src="{{ branding.logoUrl }}" alt="Current logo" width="96" height="48"></div>
                        <label class="fv-checkbox" for="remove-logo"><input id="remove-logo" name="remove_logo" type="checkbox" value="1"> Remove current logo and use the built-in default</label>
                    {% endif %}
                    {% if fieldErrors.branding_logo|default(null) %}<p class="fv-field-error" role="alert">{{ fieldErrors.branding_logo }}</p>{% endif %}
                </div>
                <div class="fv-field">
                    <label for="branding-favicon">Favicon</label>
                    <input class="fv-input" id="branding-favicon" name="favicon" type="file" accept="image/png,image/x-icon,.png,.ico">
                    <p class="fv-field-help">PNG or ICO. Maximum 256 KiB and 256 × 256 pixels.</p>
                    {% if branding.faviconUrl %}
                        <div class="fv-branding-preview"><img src="{{ branding.faviconUrl }}" alt="Current favicon" width="32" height="32"></div>
                        <label class="fv-checkbox" for="remove-favicon"><input id="remove-favicon" name="remove_favicon" type="checkbox" value="1"> Remove current favicon</label>
                    {% endif %}
                    {% if fieldErrors.branding_favicon|default(null) %}<p class="fv-field-error" role="alert">{{ fieldErrors.branding_favicon }}</p>{% endif %}
                </div>
            </div>
            <div class="fv-branding-live-preview" aria-label="Branding preview">
                <p class="fv-eyebrow">Preview</p>
                <div class="fv-brand"><span class="fv-brand-mark">{{ branding.brandMark }}</span><span class="fv-brand-copy"><span class="fv-brand-wordmark">{{ formData.brand_name }}</span>{% if formData.show_slogan == '1' and formData.slogan != '' %}<span class="fv-brand-slogan">{{ formData.slogan }}</span>{% endif %}</span></div>
            </div>
            {% include '@platform_ui/components/form_action_bar.html.twig' with {
                helpText: 'Branding changes apply to this local installation and use versioned public assets.',
                submitLabel: 'Save branding',
            } only %}
        </form>
    </section>

    <section class="fv-panel fv-settings-panel" aria-labelledby="identity-heading">
        <header class="fv-section-heading">
            <p class="fv-eyebrow">Website identity</p>
            <h2 id="identity-heading">Identify this website</h2>
            <p>These values identify the website connected to this local installation.</p>
        </header>
        <form class="fv-form" method="post" action="{{ path('spoke_admin_settings_identity_update', {tab: 'website'}) }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <div class="fv-settings-grid">
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'website-display-name',
                    name: 'website_display_name',
                    label: 'Website display name',
                    value: formData.website_display_name,
                    help: 'Shown as the website context in the administration header.',
                    error: fieldErrors.website_display_name|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'operational-alert-email',
                    name: 'operational_alert_email',
                    label: 'Operational-alert email',
                    type: 'email',
                    value: formData.operational_alert_email,
                    help: 'This installation uses this address for administrator-visible operational notifications.',
                    error: fieldErrors.operational_alert_email|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'bare-domain',
                    name: 'bare_domain',
                    label: 'Bare domain',
                    value: formData.bare_domain,
                    placeholder: 'example.com',
                    help: 'Enter the hostname without a scheme, path, port, or www prefix.',
                    error: fieldErrors.bare_domain|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'www-alias',
                    name: 'www_alias',
                    label: 'WWW alias (optional)',
                    value: formData.www_alias,
                    placeholder: 'www.example.com',
                    help: 'Use this only when the website also serves an exact www hostname.',
                    error: fieldErrors.www_alias|default(null),
                } only %}
            </div>
            {% include '@platform_ui/components/form_action_bar.html.twig' with {
                helpText: 'Changes are saved locally on this Spoke.',
                submitLabel: 'Save website identity',
            } only %}
        </form>
    </section>
    {% endif %}

    {% if activeTab == 'email' %}
    <section class="fv-panel fv-settings-panel" aria-labelledby="smtp-heading">
        <header class="fv-section-heading">
            <p class="fv-eyebrow">SMTP delivery</p>
            <h2 id="smtp-heading">Configure outgoing email</h2>
            <p>SMTP credentials stay in private local storage. The saved password is never displayed.</p>
        </header>
        <form class="fv-form" method="post" action="{{ path('spoke_admin_settings_smtp_update', {tab: 'email'}) }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <div class="fv-settings-grid">
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'sender-email',
                    name: 'sender_email',
                    label: 'Sender email',
                    type: 'email',
                    value: formData.sender_email,
                    help: 'This server-controlled address appears as the message sender.',
                    error: fieldErrors.sender_email|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'sender-name',
                    name: 'sender_name',
                    label: 'Sender display name (optional)',
                    value: formData.sender_name,
                    error: fieldErrors.sender_name|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'smtp-host',
                    name: 'smtp_host',
                    label: 'SMTP host',
                    value: formData.smtp_host,
                    placeholder: 'mail.example.com',
                    error: fieldErrors.smtp_host|default(null),
                } only %}
                <div class="fv-field">
                    <label for="smtp-encryption">Encryption mode</label>
                    <select class="fv-input" id="smtp-encryption" name="smtp_encryption">
                        <option value="smtps"{% if formData.smtp_encryption == 'smtps' %} selected{% endif %}>SMTPS (implicit TLS)</option>
                        <option value="starttls"{% if formData.smtp_encryption == 'starttls' %} selected{% endif %}>STARTTLS</option>
                    </select>
                    {% if fieldErrors.smtp_encryption|default(null) %}<p class="fv-field-error" role="alert">{{ fieldErrors.smtp_encryption }}</p>{% endif %}
                </div>
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'smtp-port',
                    name: 'smtp_port',
                    label: 'SMTP port',
                    type: 'number',
                    value: formData.smtp_port,
                    min: 1,
                    max: 65535,
                    error: fieldErrors.smtp_port|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'smtp-username',
                    name: 'smtp_username',
                    label: 'SMTP username',
                    value: formData.smtp_username,
                    autocomplete: 'username',
                    error: fieldErrors.smtp_username|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'smtp-password',
                    name: 'smtp_password',
                    label: 'SMTP password',
                    type: 'password',
                    value: '',
                    autocomplete: 'new-password',
                    help: settings.smtpSecretConfigured ? 'Leave blank to keep the current password.' : 'A password is required before SMTP can be tested.',
                    error: fieldErrors.smtp_password|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'smtp-timeout-seconds',
                    name: 'smtp_timeout_seconds',
                    label: 'Connection timeout (seconds)',
                    type: 'number',
                    value: formData.smtp_timeout_seconds,
                    min: 3,
                    max: 60,
                    help: 'The default is 10 seconds; allowed values are 3–60 seconds.',
                    error: fieldErrors.smtp_timeout_seconds|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'smtp-attempts-per-minute',
                    name: 'smtp_attempts_per_minute',
                    label: 'SMTP attempts per minute',
                    type: 'number',
                    value: formData.smtp_attempts_per_minute,
                    min: 1,
                    max: 60,
                    help: 'Default: 10. This installation-wide ceiling includes retries; use a lower value when the provider limit is lower.',
                    error: fieldErrors.smtp_attempts_per_minute|default(null),
                } only %}
            </div>
            {% include '@platform_ui/components/form_action_bar.html.twig' with {
                helpText: settings.testState.status.value == 'stale' ? 'SMTP settings changed. Send a new test after saving.' : 'Saving settings does not send email.',
                submitLabel: 'Save SMTP settings',
            } only %}
        </form>
    </section>
    {% endif %}

    {% if activeTab == 'access' %}
    <section class="fv-panel fv-settings-panel" aria-labelledby="security-heading">
        <header class="fv-section-heading">
            <p class="fv-eyebrow">Administrator security</p>
            <h2 id="security-heading">Login-throttle controls</h2>
            <p>These settings limit repeated failed administrator login attempts without permanently locking the account.</p>
        </header>
        <form class="fv-form" method="post" action="{{ path('spoke_admin_settings_security_update', {tab: 'access'}) }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <div class="fv-settings-grid">
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'maximum-failures',
                    name: 'maximum_failures',
                    label: 'Failed attempts before cooldown',
                    type: 'number',
                    value: formData.maximum_failures,
                    min: 3,
                    max: 20,
                    error: fieldErrors.maximum_failures|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'window-minutes',
                    name: 'window_minutes',
                    label: 'Rolling window (minutes)',
                    type: 'number',
                    value: formData.window_minutes,
                    min: 5,
                    max: 60,
                    error: fieldErrors.window_minutes|default(null),
                } only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'cooldown-minutes',
                    name: 'cooldown_minutes',
                    label: 'Cooldown (minutes)',
                    type: 'number',
                    value: formData.cooldown_minutes,
                    min: 5,
                    max: 120,
                    error: fieldErrors.cooldown_minutes|default(null),
                } only %}
            </div>
            {% include '@platform_ui/components/form_action_bar.html.twig' with {
                helpText: 'Defaults: 5 failed attempts, 15-minute window, 15-minute cooldown.',
                submitLabel: 'Save security settings',
            } only %}
        </form>
    </section>
    {% endif %}

    {% if activeTab == 'protection' %}
    <section class="fv-panel fv-settings-panel" aria-labelledby="discovery-heading">
        <header class="fv-section-heading">
            <p class="fv-eyebrow">Form discovery</p>
            <h2 id="discovery-heading">Discovery request limit</h2>
            <p>This limits the total metadata returned for one page, including all detected forms, controls, labels, and choices. It never permits more than 1,024 KiB.</p>
        </header>
        <form class="fv-form" method="post" action="{{ path('spoke_admin_settings_discovery_update', {tab: 'protection'}) }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <div class="fv-settings-grid">
                {% include '@platform_ui/components/settings_field.html.twig' with {
                    id: 'discovery-payload-limit-kib',
                    name: 'discovery_payload_limit_kib',
                    label: 'Discovery request limit (KiB)',
                    type: 'number',
                    value: formData.discovery_payload_limit_kib,
                    min: 128,
                    max: 1024,
                    help: 'Default: 128 KiB. Allowed range: 128–1,024 KiB.',
                    error: fieldErrors.discovery_payload_limit_kib|default(null),
                } only %}
            </div>
            {% include '@platform_ui/components/form_action_bar.html.twig' with {
                helpText: 'The limit is enforced by the server before discovery data is stored.',
                submitLabel: 'Save discovery settings',
            } only %}
        </form>
    </section>

    <section class="fv-panel fv-settings-panel" aria-labelledby="abuse-heading">
        <header class="fv-section-heading">
            <p class="fv-eyebrow">Public abuse controls</p>
            <h2 id="abuse-heading">Rate limits and CAPTCHA</h2>
            <p>These controls apply to every active public form. Rate-limit identities are privacy-preserving hashes; forwarded visitor IPs are trusted only from the proxy CIDRs listed below.</p>
        </header>
        {% if abuseSettings.outageState.open %}
            <div class="fv-alert fv-alert-danger" role="alert"><strong>CAPTCHA provider unavailable.</strong><span>Enabled CAPTCHA forms remain blocked until verification succeeds. Last reason: {{ abuseSettings.outageState.lastFailureCode|default('provider unavailable') }}.</span></div>
        {% endif %}
        <form class="fv-form" method="post" action="{{ path('spoke_admin_settings_abuse_update', {tab: 'protection'}) }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <div class="fv-settings-grid">
                {% include '@platform_ui/components/settings_field.html.twig' with {id: 'abuse-per-form-short', name: 'per_form_short_limit', label: 'New attempts per form / 10 minutes', type: 'number', value: formData.per_form_short_limit, min: 1, max: 1000, help: 'Default: 5. Invalid and suspected-spam new attempts count; matching accepted retries do not.', error: fieldErrors.per_form_short_limit|default(null)} only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {id: 'abuse-per-form-hour', name: 'per_form_hour_limit', label: 'New attempts per form / hour', type: 'number', value: formData.per_form_hour_limit, min: 1, max: 10000, help: 'Default: 20.', error: fieldErrors.per_form_hour_limit|default(null)} only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {id: 'abuse-installation-hour', name: 'installation_hour_limit', label: 'New attempts per IP / hour', type: 'number', value: formData.installation_hour_limit, min: 1, max: 10000, help: 'Default: 30 across all active forms.', error: fieldErrors.installation_hour_limit|default(null)} only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {id: 'abuse-flood-minute', name: 'flood_minute_limit', label: 'All submission requests / minute', type: 'number', value: formData.flood_minute_limit, min: 10, max: 10000, help: 'Default: 60. This cheap guard also counts malformed and retry requests.', error: fieldErrors.flood_minute_limit|default(null)} only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {id: 'abuse-flood-hour', name: 'flood_hour_limit', label: 'All submission requests / hour', type: 'number', value: formData.flood_hour_limit, min: 10, max: 100000, help: 'Default: 300.', error: fieldErrors.flood_hour_limit|default(null)} only %}
                {% include '@platform_ui/components/settings_field.html.twig' with {id: 'turnstile-secret', name: 'turnstile_secret', label: 'Turnstile secret key', type: 'password', value: '', autocomplete: 'new-password', help: abuseSettings.turnstileSecretConfigured ? 'Leave blank to keep the current private secret.' : 'Required before publishing a CAPTCHA-enabled form.', error: fieldErrors.turnstile_secret|default(null)} only %}
            </div>
            <div class="fv-field">
                <label for="trusted-proxy-cidrs">Trusted reverse-proxy CIDRs</label>
                <textarea class="fv-input" id="trusted-proxy-cidrs" name="trusted_proxy_cidrs" rows="4" spellcheck="false">{{ formData.trusted_proxy_cidrs }}</textarea>
                <p class="fv-field-help">Optional: one CIDR per line, such as 203.0.113.0/24. Leave empty to use the direct connection address and ignore forwarded IP headers.</p>
                {% if fieldErrors.trusted_proxy_cidrs|default(null) %}<p class="fv-field-error" role="alert">{{ fieldErrors.trusted_proxy_cidrs }}</p>{% endif %}
            </div>
            {% include '@platform_ui/components/form_action_bar.html.twig' with {helpText: 'Defaults: 5 / 20 / 30 attempts and 60 / 300 request flood limits.', submitLabel: 'Save abuse controls'} only %}
        </form>
        <div class="fv-action-bar">
            <form method="post" action="{{ path('spoke_admin_settings_abuse_reset', {tab: 'protection'}) }}">
                <input type="hidden" name="_token" value="{{ csrfToken }}"><input type="hidden" name="confirm_action" value="1">
                <button class="fv-button fv-button-secondary" type="submit">Restore abuse defaults</button>
            </form>
            <form method="post" action="{{ path('spoke_admin_settings_abuse_clear_counters', {tab: 'protection'}) }}">
                <input type="hidden" name="_token" value="{{ csrfToken }}"><input type="hidden" name="confirm_action" value="1">
                <button class="fv-button fv-button-secondary" type="submit">Clear active counters</button>
            </form>
        </div>
    </section>
    {% endif %}

    {% if activeTab == 'email' %}
    <section class="fv-panel fv-settings-panel" aria-labelledby="smtp-test-heading">
        <header class="fv-section-heading">
            <p class="fv-eyebrow">Explicit action</p>
            <h2 id="smtp-test-heading">Send a test email</h2>
            <p>Enter one address where you want to receive the test. No test is sent automatically when this page opens or when settings are saved.</p>
        </header>
        {% if settings.smtpReady and settings.testState.status.value == 'passed' and settings.testState.testedRevision == settings.settings.smtpConfigurationRevision %}
            <div class="fv-alert" role="status"><strong>SMTP test passed.</strong><span>{{ settings.testState.summary }}</span></div>
        {% elseif settings.testState.status.value == 'uncertain' %}
            <div class="fv-alert fv-alert-danger" role="alert"><strong>SMTP result is uncertain.</strong><span>{{ settings.testState.summary }}</span></div>
        {% elseif settings.testState.status.value == 'failed' %}
            <div class="fv-alert fv-alert-danger" role="alert"><strong>SMTP test failed.</strong><span>{{ settings.testState.summary }}</span></div>
        {% elseif settings.testState.status.value == 'stale' %}
            <div class="fv-alert" role="status"><strong>New SMTP test required.</strong><span>{{ settings.testState.summary }}</span></div>
        {% else %}
            <div class="fv-alert" role="status"><strong>SMTP is not ready.</strong><span>Save a valid SMTP host, sender address, username, and password before sending a test.</span></div>
        {% endif %}
        <form class="fv-form" method="post" action="{{ path('spoke_admin_settings_smtp_test', {tab: 'email'}) }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <div class="fv-settings-test-row">
                <div class="fv-field">
                    <label for="test-recipient">Test recipient</label>
                    <input class="fv-input" id="test-recipient" name="test_recipient" type="email" value="{{ testRecipient }}" autocomplete="email" required>
                    <p class="fv-field-help">Use exactly one valid email address. The address is used only for this test and is not saved.</p>
                    {% if fieldErrors.test_recipient|default(null) %}<p class="fv-field-error" role="alert">{{ fieldErrors.test_recipient }}</p>{% endif %}
                </div>
                <div class="fv-settings-test-action">
                    <button class="fv-button fv-button-primary" type="submit"{% if not settings.smtpReady %} disabled{% endif %}>Send test email</button>
                </div>
            </div>
        </form>
    </section>
    {% endif %}
</div>
{% endblock %}
