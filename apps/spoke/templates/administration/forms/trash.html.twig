{% extends 'administration/portal_layout.html.twig' %}

{% block title %}Form Trash · {{ branding.brandName }}{% endblock %}

{% block content %}
<div class="fv-page">
    <nav class="fv-breadcrumbs" aria-label="Breadcrumbs"><a href="{{ path('spoke_admin_home') }}">Overview</a><span aria-hidden="true">/</span><a href="{{ path('spoke_admin_forms') }}">Forms</a><span aria-hidden="true">/</span><span aria-current="page">Trash</span></nav>
    {% include '@platform_ui/components/page_header.html.twig' with {pageTitle: 'Form Trash', pageDescription: 'Review removed forms before restoring or permanently deleting them.'} only %}
    {% include '@platform_ui/components/feedback.html.twig' with {message: message, title: 'Trash notice', variant: messageVariant} only %}
    <section class="fv-panel" aria-labelledby="trash-heading">
        <div class="fv-section-heading"><p class="fv-eyebrow">Recoverable records</p><h2 id="trash-heading">Removed forms</h2><p>Permanent deletion is manual, audited, and rejected when protected records reference the form.</p></div>
        {% if forms is empty %}<p>No forms are currently in Trash.</p>{% else %}
            <div class="fv-table-container" tabindex="0" aria-label="Removed forms table"><table class="fv-table"><thead><tr><th scope="col">Form</th><th scope="col">Last published</th><th scope="col">Actions</th></tr></thead><tbody>
            {% for form in forms %}<tr><th scope="row">{{ form.displayName }}</th><td>{% if form.publishedState %}v{{ form.publishedVersion }} · {{ form.publishedState.value|capitalize }}{% else %}Not published{% endif %}</td><td><a class="fv-button fv-button-secondary" href="{{ path('spoke_admin_form_edit', {publicFormId: form.publicId}) }}">Review</a></td></tr>{% endfor %}
            </tbody></table></div>
            {% include '@platform_ui/components/pagination.html.twig' with {
                pages: pagination.pages,
                total: pagination.total,
                firstItem: pagination.firstItem,
                lastItem: pagination.lastItem,
                currentPage: pagination.page,
                pageCount: pagination.pageCount,
                pageParameter: pagination.pageParameter,
                previous: pagination.previous,
                next: pagination.next,
                pageSizeControl: {action: path('spoke_admin_forms_trash'), id: 'trash-page-size', name: 'page_size', value: pagination.pageSize, options: [25, 50, 100], hidden: []},
                ariaLabel: 'Form Trash pages',
            } only %}
        {% endif %}
    </section>
</div>
{% endblock %}
