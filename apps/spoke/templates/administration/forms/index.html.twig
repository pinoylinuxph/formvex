{% extends 'administration/portal_layout.html.twig' %}

{% block title %}Forms · {{ branding.brandName }}{% endblock %}

{% block content %}
<div class="fv-page">
    <nav class="fv-breadcrumbs" aria-label="Breadcrumbs">
        <a href="{{ path('spoke_admin_home') }}">Overview</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Forms</span>
    </nav>

    {% include '@platform_ui/components/page_header.html.twig' with {
        pageTitle: pageTitle,
        pageDescription: pageDescription,
        primaryActionLabel: 'Create form configuration',
        primaryActionHref: path('spoke_admin_form_new'),
    } only %}

    {% include '@platform_ui/components/feedback.html.twig' with {
        message: message,
        title: messageVariant == 'success' ? 'Saved' : 'Forms notice',
        variant: messageVariant,
    } only %}

    {% if changeWarnings is not empty %}
        <section class="fv-alert fv-alert-warning" aria-labelledby="form-change-warnings-heading">
            <div>
                <strong id="form-change-warnings-heading">Website form changes need review.</strong>
                <span>The installed page reports a different form structure than the active approved configuration. Review the form before treating the change as intentional.</span>
            </div>
            <div class="fv-table-container" tabindex="0" aria-label="Form change warnings table">
                <table class="fv-table">
                    <thead>
                    <tr><th scope="col">Page</th><th scope="col">Form marker</th><th scope="col">Changes</th><th scope="col">Last observed</th><th scope="col"><span class="fv-visually-hidden">Actions</span></th></tr>
                    </thead>
                    <tbody>
                    {% for warning in changeWarnings %}
                        <tr>
                            <th scope="row"><a href="{{ path('spoke_admin_form_edit', {publicFormId: warning.formPublicId}) }}">{{ warning.pagePath }}</a></th>
                            <td><code>{{ warning.formMarker }}</code></td>
                            <td>
                                <ul class="fv-compact-list">
                                    {% for difference in warning.differences %}
                                        <li>{{ difference.kind|replace({'_': ' '})|title }} <code>{{ difference.control_key }}</code></li>
                                    {% endfor %}
                                </ul>
                            </td>
                            <td><time datetime="{{ warning.lastObservedAt|date('c') }}">{{ warning.lastObservedAt|date('Y-m-d H:i') }}</time></td>
                            <td>
                                <div class="fv-inline-actions">
                                    <a class="fv-button fv-button-secondary" href="{{ path('spoke_admin_form_edit', {publicFormId: warning.formPublicId}) }}">Review form</a>
                                    <form method="post" action="{{ path('spoke_admin_form_change_observation_resolve', {observationId: warning.publicId}) }}">
                                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                                        <button class="fv-button fv-button-secondary" type="submit">Mark reviewed</button>
                                    </form>
                                    <form method="post" action="{{ path('spoke_admin_form_change_observation_discard', {observationId: warning.publicId}) }}">
                                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                                        <button class="fv-button fv-button-danger" type="submit">Discard</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}

    <section class="fv-panel">
        {% if forms is empty %}
            {% include '@platform_ui/components/empty_state.html.twig' with {
                eyebrow: 'No forms',
                headingId: 'forms-empty-heading',
                title: 'Create the first form configuration',
                message: 'Start with the page identity and form marker detected from the existing website source.',
            } only %}
        {% else %}
            <div class="fv-table-container" tabindex="0" aria-label="Configured forms table">
                <table class="fv-table">
                    <thead>
                    <tr><th scope="col">Form</th><th scope="col">Draft</th><th scope="col">Published</th><th scope="col">Updated</th><th scope="col"><span class="fv-visually-hidden">Actions</span></th></tr>
                    </thead>
                    <tbody>
                    {% for form in forms %}
                        <tr>
                            <th scope="row"><a href="{{ path('spoke_admin_form_edit', {publicFormId: form.publicId}) }}">{{ form.displayName }}</a></th>
                            <td>Revision {{ form.draftRevision }}</td>
                            <td>{% if form.publishedState %}v{{ form.publishedVersion }} · {{ form.publishedState.value|capitalize }}{% else %}Not published{% endif %}</td>
                            <td><time datetime="{{ form.updatedAt|date('c') }}">{{ form.updatedAt|date('Y-m-d H:i') }}</time></td>
                            <td><a class="fv-button fv-button-secondary" href="{{ path('spoke_admin_form_edit', {publicFormId: form.publicId}) }}">Open</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include '@platform_ui/components/pagination.html.twig' with {
                pages: pagination.pages,
                total: pagination.total,
                firstItem: pagination.firstItem,
                lastItem: pagination.lastItem,
                currentPage: pagination.page,
                pageCount: pagination.pageCount,
                pageParameter: pagination.pageParameter,
                previous: pagination.previous,
                next: pagination.next,
                pageSizeControl: {action: path('spoke_admin_forms'), id: 'forms-page-size', name: 'page_size', value: pagination.pageSize, options: [25, 50, 100], hidden: []},
                ariaLabel: 'Form pages',
            } only %}
        {% endif %}
    </section>

    <p class="fv-page-note"><a href="{{ path('spoke_admin_forms_trash') }}">Open Trash{% if trashCount > 0 %} ({{ trashCount }}){% endif %}</a></p>
</div>
{% endblock %}
