{% extends 'administration/portal_layout.html.twig' %}

{% block title %}Forms · Formvex{% endblock %}

{% block content %}
<div class="fv-page">
    <nav class="fv-breadcrumbs" aria-label="Breadcrumbs">
        <a href="{{ path('spoke_admin_home') }}">Overview</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Forms</span>
    </nav>

    {% include '@platform_ui/components/page_header.html.twig' with {
        pageTitle: pageTitle,
        pageDescription: pageDescription,
        actionLabel: 'Create form configuration',
        actionUrl: path('spoke_admin_form_new'),
    } only %}

    {% include '@platform_ui/components/feedback.html.twig' with {
        message: message,
        title: messageVariant == 'success' ? 'Saved' : 'Forms notice',
        variant: messageVariant,
    } only %}

    <section class="fv-panel" aria-labelledby="forms-list-heading">
        <div class="fv-section-heading">
            <p class="fv-eyebrow">Configuration inventory</p>
            <h2 id="forms-list-heading">Configured forms</h2>
            <p>Drafts remain private. A published version is not publicly resolvable until the activation unit approves it.</p>
        </div>
        {% if forms is empty %}
            {% include '@platform_ui/components/empty_state.html.twig' with {
                eyebrow: 'No forms',
                headingId: 'forms-empty-heading',
                title: 'Create the first form configuration',
                message: 'Start with the page identity and form marker detected from the existing website source.',
            } only %}
        {% else %}
            <div class="fv-table-wrap">
                <table class="fv-table">
                    <thead>
                    <tr><th scope="col">Form</th><th scope="col">Draft</th><th scope="col">Published</th><th scope="col">Updated</th><th scope="col"><span class="fv-visually-hidden">Actions</span></th></tr>
                    </thead>
                    <tbody>
                    {% for form in forms %}
                        <tr>
                            <th scope="row"><a href="{{ path('spoke_admin_form_edit', {publicFormId: form.publicId}) }}">{{ form.displayName }}</a></th>
                            <td>Revision {{ form.draftRevision }}</td>
                            <td>{% if form.publishedState %}v{{ form.publishedVersion }} · {{ form.publishedState.value|capitalize }}{% else %}Not published{% endif %}</td>
                            <td><time datetime="{{ form.updatedAt|date('c') }}">{{ form.updatedAt|date('Y-m-d H:i') }}</time></td>
                            <td><a class="fv-button fv-button-secondary fv-button-small" href="{{ path('spoke_admin_form_edit', {publicFormId: form.publicId}) }}">Open</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <p class="fv-page-note"><a href="{{ path('spoke_admin_forms_trash') }}">Open Trash{% if trashCount > 0 %} ({{ trashCount }}){% endif %}</a></p>
</div>
{% endblock %}
