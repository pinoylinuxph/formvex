{% extends 'administration/auth_layout.html.twig' %}

{% block title %}{{ branding.brandName }} administrator sign in{% endblock %}

{% block content %}
    <header class="fv-auth-title">
        <p class="fv-eyebrow">Local administrator portal</p>
        <h1>Sign in to {{ branding.brandName }}</h1>
        <p>Manage this website's local form-processing installation.</p>
    </header>
    {% if error %}
        {% include '@platform_ui/components/feedback.html.twig' with {
            message: error,
            title: 'Sign-in failed',
            variant: 'danger',
        } only %}
    {% endif %}
    <form class="fv-form" method="post" action="{{ path('spoke_admin_login') }}">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <div class="fv-field">
            <label for="login-identifier">Login identifier</label>
            <input class="fv-input" id="login-identifier" name="login_identifier" type="text" value="admin" autocomplete="username" required>
        </div>
        <div class="fv-field">
            <label for="password">Password</label>
            <input class="fv-input" id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="fv-button fv-button-primary fv-button-block" type="submit">Sign in</button>
    </form>
{% endblock %}
