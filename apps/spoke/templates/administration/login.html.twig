<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Formvex administrator sign in</title>
</head>
<body>
<main>
    <h1>Formvex administrator sign in</h1>
    {% if error %}
        <p role="alert">{{ error }}</p>
    {% endif %}
    <form method="post" action="{{ path('spoke_admin_login') }}">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <p>
            <label for="login-identifier">Login identifier</label>
            <input id="login-identifier" name="login_identifier" type="text" value="admin" autocomplete="username" required>
        </p>
        <p>
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required>
        </p>
        <button type="submit">Sign in</button>
    </form>
</main>
</body>
</html>
