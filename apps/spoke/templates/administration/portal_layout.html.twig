{% set currentTheme = theme|default('light') %}
<!doctype html>
<html lang="en" data-theme="{{ currentTheme }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script>
        (() => {
            const root = document.documentElement;
            const saved = document.cookie.split('; ').find((item) => item.startsWith('formvex_theme='))?.split('=')[1];
            const preferred = saved === 'light' || saved === 'dark'
                ? saved
                : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            root.dataset.theme = preferred;
            root.style.colorScheme = preferred;
        })();
    </script>
    <link rel="stylesheet" href="/build/formvex-ui.css">
    <script type="module" src="/build/spoke-admin.js" defer></script>
    <title>{% block title %}{{ pageTitle|default('Formvex administration') }}{% endblock %}</title>
</head>
<body class="fv-app" data-sidebar-state="{{ sidebarState }}">
<a class="fv-skip-link" href="#main-content">Skip to main content</a>
<header class="fv-navbar">
    <div class="fv-navbar-leading">
        <button class="fv-icon-button fv-mobile-menu-button" type="button" data-sidebar-open aria-controls="fv-sidebar" aria-expanded="false">
            <span aria-hidden="true">☰</span>
            <span class="fv-visually-hidden">Open navigation</span>
        </button>
        <a class="fv-brand" href="{{ path('spoke_admin_home') }}" aria-label="Formvex overview">
            <span class="fv-brand-mark" aria-hidden="true">F</span>
            <span class="fv-brand-wordmark">Formvex</span>
        </a>
        <span class="fv-navbar-divider" aria-hidden="true">·</span>
        <span class="fv-navbar-context">{{ websiteName }}</span>
    </div>
    <div class="fv-navbar-trailing">
        {% include '@platform_ui/components/theme_control.html.twig' with {
            authenticated: true,
            csrfToken: csrfToken,
            currentRoute: currentRoute,
            theme: currentTheme,
        } only %}
        <details class="fv-account-menu">
            <summary>{{ administratorName }}</summary>
            <div class="fv-popover" role="menu">
                <span class="fv-account-label">Local administrator</span>
                <form method="post" action="{{ path('spoke_admin_logout') }}">
                    <input type="hidden" name="_token" value="{{ csrfToken }}">
                    <button class="fv-menu-action" type="submit">Sign out</button>
                </form>
            </div>
        </details>
    </div>
</header>
<div class="fv-sidebar-backdrop" data-sidebar-backdrop hidden></div>
<aside id="fv-sidebar" class="fv-sidebar" aria-label="Primary navigation" data-sidebar>
    <div class="fv-sidebar-header">
        <span class="fv-sidebar-title">Workspace</span>
        <button class="fv-icon-button fv-sidebar-close" type="button" data-sidebar-close aria-label="Close navigation">×</button>
    </div>
    <button class="fv-sidebar-collapse" type="button" data-sidebar-toggle aria-controls="fv-sidebar" aria-expanded="{{ sidebarState == 'expanded' ? 'true' : 'false' }}">
        <span aria-hidden="true">‹</span>
        <span class="fv-sidebar-collapse-label">Collapse navigation</span>
    </button>
    <nav class="fv-nav" aria-label="Local Spoke">
        <ul class="fv-nav-list">
            {% for item in navItems %}
                <li>
                    <a class="fv-nav-link{{ item.route == currentRoute ? ' is-active' : '' }}" href="{{ path(item.route) }}" title="{{ item.label }}"{% if item.route == currentRoute %} aria-current="page"{% endif %}>
                        {% include '@platform_ui/components/navigation_icon.html.twig' with {name: item.icon} only %}
                        <span class="fv-nav-label">{{ item.label }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>
</aside>
<main id="main-content" class="fv-main">
    {% block content %}{% endblock %}
</main>
</body>
</html>
