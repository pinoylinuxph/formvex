<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Change Formvex administrator password</title>
</head>
<body>
<main>
    <h1>Change your Formvex administrator password</h1>
    <p>A new password is required before you can continue.</p>
    {% if error %}
        <p role="alert">{{ error }}</p>
    {% endif %}
    <form method="post" action="{{ path('spoke_admin_password_change') }}">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <p>
            <label for="new-password">New password</label>
            <input id="new-password" name="new_password" type="password" autocomplete="new-password" required minlength="12">
        </p>
        <p>
            <label for="confirmation">Confirm new password</label>
            <input id="confirmation" name="confirmation" type="password" autocomplete="new-password" required minlength="12">
        </p>
        <button type="submit">Change password</button>
    </form>
</main>
</body>
</html>
