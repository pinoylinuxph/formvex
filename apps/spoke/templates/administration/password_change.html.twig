{% extends 'administration/auth_layout.html.twig' %}

{% block title %}Change Formvex administrator password{% endblock %}

{% block content %}
    <header class="fv-auth-title">
        <p class="fv-eyebrow">First sign-in step</p>
        <h1>Choose a new password</h1>
        <p>A new password is required before you can continue to the portal.</p>
    </header>
    {% if error %}
        {% include '@platform_ui/components/feedback.html.twig' with {
            message: error,
            title: 'Password not changed',
            variant: 'danger',
        } only %}
    {% endif %}
    <form class="fv-form" method="post" action="{{ path('spoke_admin_password_change') }}">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <div class="fv-field">
            <label for="new-password">New password</label>
            <p class="fv-field-help">Use at least 12 characters. Passphrases are allowed.</p>
            <input class="fv-input" id="new-password" name="new_password" type="password" autocomplete="new-password" required minlength="12">
        </div>
        <div class="fv-field">
            <label for="confirmation">Confirm new password</label>
            <input class="fv-input" id="confirmation" name="confirmation" type="password" autocomplete="new-password" required minlength="12">
        </div>
        <button class="fv-button fv-button-primary fv-button-block" type="submit">Save new password</button>
    </form>
{% endblock %}
