{% extends 'administration/portal_layout.html.twig' %}

{% block title %}{{ pageTitle }} · {{ branding.brandName }}{% endblock %}

{% block content %}
<div class="fv-page">
    {% if not isOverview %}
        <nav class="fv-breadcrumbs" aria-label="Breadcrumbs">
            <a href="{{ path('spoke_admin_home') }}">Overview</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{{ pageTitle }}</span>
        </nav>
    {% endif %}

    {% include '@platform_ui/components/page_header.html.twig' with {
        pageTitle: pageTitle,
        pageDescription: pageDescription,
    } only %}

    {% include '@platform_ui/components/feedback.html.twig' with {
        message: notice,
        variant: noticeVariant,
    } only %}

    {% if isOverview %}
        <div class="fv-overview-toolbar">
            <p class="fv-overview-snapshot" role="status">{{ overview.snapshotLabel }}</p>
            <a class="fv-button fv-button-secondary" href="{{ path('spoke_admin_home') }}">Refresh status</a>
        </div>

        {% if overview.warnings is not empty %}
            <section class="fv-overview-attention" aria-labelledby="overview-attention-heading">
                <header class="fv-section-heading">
                    <p class="fv-eyebrow">Action required</p>
                    <h2 id="overview-attention-heading">Needs attention</h2>
                    <p>These notices remain visible until the underlying status changes.</p>
                </header>
                <div class="fv-overview-warning-list">
                    {% for warning in overview.warnings %}
                        <article class="fv-alert fv-alert-{{ warning.severity }}" role="alert">
                            <div>
                                <strong>{{ warning.title }}</strong>
                                <span>{{ warning.message }}</span>
                            </div>
                            <a class="fv-button fv-button-secondary" href="{{ path(warning.route) }}">{{ warning.routeLabel }}</a>
                        </article>
                    {% endfor %}
                </div>
            </section>
        {% else %}
            <div class="fv-alert fv-alert-success" role="status"><strong>No attention required.</strong><span>The current local status snapshot has no recorded action requiring administrator review.</span></div>
        {% endif %}

        <section class="fv-overview-card-grid" aria-label="Operational summary">
            {% for card in overview.cards %}
                <article class="fv-overview-card fv-overview-card-{{ card.severity }}">
                    <header class="fv-overview-card-header">
                        <div>
                            <p class="fv-eyebrow">{{ card.label }}</p>
                            <h2>{{ card.primaryValue }}</h2>
                        </div>
                        <span class="fv-status-badge fv-status-badge-{{ card.severity }}">{{ card.status }}</span>
                    </header>
                    <p class="fv-overview-card-summary">{{ card.summary }}</p>
                    {% if card.meterValue is not null and card.meterMax is not null %}
                        <progress class="fv-overview-meter" value="{{ card.meterValue }}" max="{{ card.meterMax }}" aria-label="{{ card.meterLabel }}">{{ card.meterLabel }}</progress>
                    {% elseif card.segments is not empty %}
                        <div class="fv-overview-bar" role="img" aria-label="{{ card.label }} distribution">
                            {% for segment in card.segments %}
                                <span class="fv-overview-bar-segment fv-overview-bar-{{ segment.tone }}" style="width: {{ segment.percent }}%;" title="{{ segment.label }}: {{ segment.value }}"></span>
                            {% endfor %}
                        </div>
                        <ul class="fv-overview-legend">
                            {% for segment in card.segments %}
                                <li><span class="fv-overview-legend-swatch fv-overview-bar-{{ segment.tone }}" aria-hidden="true"></span><span>{{ segment.label }}</span><strong>{{ segment.value }}</strong></li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if card.stats is not empty %}
                        <dl class="fv-overview-stats">
                            {% for stat in card.stats %}
                                <div>
                                    <dt>{{ stat.label }}</dt>
                                    <dd><strong class="fv-overview-stat-{{ stat.severity }}">{{ stat.value }}</strong><span>{{ stat.detail }}</span></dd>
                                </div>
                            {% endfor %}
                        </dl>
                    {% endif %}
                    {% if card.route %}<a class="fv-overview-card-link" href="{{ path(card.route) }}">{{ card.routeLabel }} <span aria-hidden="true">→</span></a>{% endif %}
                </article>
            {% endfor %}
        </section>

        <section class="fv-panel fv-overview-system-panel" aria-labelledby="overview-system-heading">
            <header class="fv-section-heading fv-section-heading-inline">
                <div>
                    <p class="fv-eyebrow">Local installation</p>
                    <h2 id="overview-system-heading">System status</h2>
                    <p>Configuration readiness, worker heartbeats, retention, recovery, and manual backup inventory.</p>
                </div>
            </header>
            {% if overview.systemStatus is not empty %}
                <div class="fv-overview-status-list">
                    {% for row in overview.systemStatus %}
                        <div class="fv-overview-status-row">
                            <div>
                                <strong>{{ row.label }}</strong>
                                <span>{{ row.detail }}</span>
                            </div>
                            <span class="fv-status-badge fv-status-badge-{{ row.severity }}">{{ row.status }}</span>
                            <a class="fv-button fv-button-secondary" href="{{ path(row.route) }}">{{ row.routeLabel }}</a>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="fv-empty-state"><strong>System status unavailable.</strong><p>Open Diagnostics or Maintenance to inspect the local installation.</p></div>
            {% endif %}
        </section>
    {% elseif destination == 'diagnostics' %}
        {% if schedulerHealth.status != 'healthy' %}
            <div class="fv-alert fv-alert-{{ schedulerHealth.severity }}" role="alert">
                <strong>Scheduler attention required.</strong>
                <span>{{ schedulerHealth.message }}</span>
            </div>
        {% else %}
            <div class="fv-alert fv-alert-success" role="status">
                <strong>All scheduled tasks are healthy.</strong>
                <span>{{ schedulerHealth.message }}</span>
            </div>
        {% endif %}

        <section class="fv-panel" aria-labelledby="scheduler-health-heading">
            <header class="fv-section-heading fv-section-heading-inline">
                <div>
                    <p class="fv-eyebrow">Background execution</p>
                    <h2 id="scheduler-health-heading">Scheduler health</h2>
                    <p>Each task reports its own result from the local hosting scheduler. The page cannot inspect cPanel or operating-system cron configuration directly.</p>
                </div>
                <a class="fv-button fv-button-secondary" href="{{ path('spoke_admin_diagnostics') }}">Refresh status</a>
            </header>

            <div class="fv-table-container" tabindex="0" aria-label="Scheduler health table">
                <table class="fv-table fv-scheduler-table">
                    <caption class="fv-visually-hidden">Scheduled task health</caption>
                    <thead>
                    <tr>
                        <th scope="col">Job</th>
                        <th scope="col">Schedule</th>
                        <th scope="col">Status</th>
                        <th scope="col">Last successful run</th>
                        <th scope="col">Latest attempt</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for job in schedulerHealth.jobs %}
                        <tr>
                            <th scope="row">
                                <button class="fv-table-row-trigger" type="button" data-discovery-dialog-open="scheduler-dialog-{{ job.key }}" aria-haspopup="dialog">
                                    {{ job.label }}
                                </button>
                                <span class="fv-table-cell-note">{{ job.description|default('Scheduled local task') }}</span>
                            </th>
                            <td>{{ job.schedule }}</td>
                            <td><span class="fv-status-badge fv-status-badge-{{ job.severity }}">{{ job.status|replace({'_': ' '})|title }}</span></td>
                            <td>{% if job.lastSuccessfulAt %}<time datetime="{{ job.lastSuccessfulAt }}">{{ job.lastSuccessfulAt|date('Y-m-d H:i:s T') }}</time>{% else %}Never{% endif %}</td>
                            <td>{% if job.lastAttemptAt %}<time datetime="{{ job.lastAttemptAt }}">{{ job.lastAttemptAt|date('Y-m-d H:i:s T') }}</time>{% else %}Not run{% endif %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        {% for job in schedulerHealth.jobs %}
            <section class="fv-modal fv-discovery-dialog fv-scheduler-dialog" id="scheduler-dialog-{{ job.key }}" role="dialog" aria-modal="true" aria-labelledby="scheduler-dialog-{{ job.key }}-heading" data-discovery-dialog>
                <div class="fv-modal-panel">
                    <header class="fv-modal-header">
                        <div>
                            <p class="fv-eyebrow">Scheduled task</p>
                            <h2 id="scheduler-dialog-{{ job.key }}-heading">{{ job.label }}</h2>
                        </div>
                        <button class="fv-icon-button" type="button" data-modal-close aria-label="Close scheduler details">×</button>
                    </header>
                    <div class="fv-modal-body">
                        <p class="fv-modal-description">{{ job.description|default('Scheduled local task') }}</p>
                        <dl class="fv-detail-list">
                            <div><dt>Status</dt><dd><span class="fv-status-badge fv-status-badge-{{ job.severity }}">{{ job.status|replace({'_': ' '})|title }}</span></dd></div>
                            <div><dt>Expected schedule</dt><dd>{{ job.schedule }}</dd></div>
                            <div><dt>Last successful run</dt><dd>{% if job.lastSuccessfulAt %}<time datetime="{{ job.lastSuccessfulAt }}">{{ job.lastSuccessfulAt|date('Y-m-d H:i:s T') }}</time>{% else %}Never recorded{% endif %}</dd></div>
                            <div><dt>Latest attempt</dt><dd>{% if job.lastAttemptAt %}<time datetime="{{ job.lastAttemptAt }}">{{ job.lastAttemptAt|date('Y-m-d H:i:s T') }}</time>{% else %}Not recorded{% endif %}</dd></div>
                        </dl>
                        <div class="fv-detail-callout">
                            <strong>What to do</strong>
                            <p>{{ job.action }}</p>
                            <p>Scheduled command: <code>{{ job.command }}</code></p>
                        </div>
                    </div>
                    <footer class="fv-modal-footer">
                        <button class="fv-button fv-button-secondary" type="button" data-modal-close>Done reviewing</button>
                    </footer>
                </div>
            </section>
        {% endfor %}
    {% elseif destination == 'maintenance' %}
        {% set maintenanceStatus = recoveryHold ? 'Recovery hold' : 'Ready for maintenance' %}
        {% set maintenanceSeverity = recoveryHold ? 'danger' : 'success' %}
        {% set backupStatus = backupError ? 'Unavailable' : (backupPagination.total > 0 ? 'Available' : 'None yet') %}
        {% set backupSeverity = backupError ? 'warning' : (backupPagination.total > 0 ? 'success' : 'warning') %}

        <section class="fv-maintenance-summary" aria-labelledby="maintenance-summary-heading">
            <header class="fv-maintenance-summary-header">
                <div>
                    <p class="fv-eyebrow">Operations posture</p>
                    <h2 id="maintenance-summary-heading">Maintenance control</h2>
                </div>
                <span class="fv-status-badge fv-status-badge-{{ maintenanceSeverity }}">{{ maintenanceStatus }}</span>
            </header>
            <div class="fv-maintenance-status-grid">
                <div class="fv-maintenance-status-item">
                    <span>Recovery state</span>
                    <strong class="fv-maintenance-status-{{ maintenanceSeverity }}">{{ recoveryHold ? 'Action required' : 'Clear' }}</strong>
                </div>
                <div class="fv-maintenance-status-item">
                    <span>Backup inventory</span>
                    <strong class="fv-maintenance-status-{{ backupSeverity }}">{{ backupStatus }}</strong>
                </div>
                <div class="fv-maintenance-status-item">
                    <span>Retention scheduler</span>
                    <strong class="fv-maintenance-status-{{ retentionSchedulerJob.severity }}">{{ retentionSchedulerJob.status|replace({'_': ' '})|title }}</strong>
                </div>
            </div>
        </section>

        {% if recoveryHold %}
            <div class="fv-alert fv-alert-danger" role="alert"><strong>Recovery hold is active.</strong><span>The installation is unavailable while the hosting administrator completes or repairs a server-side restore. Backup actions are paused.</span></div>
        {% endif %}

        <section class="fv-maintenance-section" aria-labelledby="backup-actions-heading">
            <header class="fv-section-heading">
                <p class="fv-eyebrow">Recovery packages</p>
                <h2 id="backup-actions-heading">Create a backup</h2>
                <p>Use a manual snapshot for routine recovery or a pre-upgrade snapshot before changing the installation.</p>
            </header>
            {% if backupError %}<div class="fv-alert fv-alert-warning" role="status"><strong>Backup inventory unavailable.</strong><span>{{ backupError }}</span></div>{% endif %}
            <div class="fv-maintenance-action-grid">
                <article class="fv-maintenance-action-card">
                    <div>
                        <p class="fv-eyebrow">Routine recovery</p>
                        <h3>Manual backup</h3>
                        <p>Capture the current private installation state.</p>
                    </div>
                    <form method="post" action="{{ path('spoke_admin_backup_create') }}">
                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                        <input type="hidden" name="kind" value="manual">
                        <button class="fv-button fv-button-primary" type="submit"{% if recoveryHold %} disabled{% endif %}>Create manual backup</button>
                    </form>
                </article>
                <article class="fv-maintenance-action-card">
                    <div>
                        <p class="fv-eyebrow">Release safety</p>
                        <h3>Pre-upgrade backup</h3>
                        <p>Capture a rollback point before an application upgrade.</p>
                    </div>
                    <form method="post" action="{{ path('spoke_admin_backup_create') }}">
                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                        <input type="hidden" name="kind" value="pre_upgrade">
                        <button class="fv-button fv-button-secondary" type="submit"{% if recoveryHold %} disabled{% endif %}>Create pre-upgrade backup</button>
                    </form>
                </article>
            </div>
            <p class="fv-maintenance-note">Archives are plain ZIP files without encryption or password protection. Store downloaded copies securely.</p>
        </section>

        <section class="fv-maintenance-section fv-maintenance-inventory" aria-labelledby="backup-inventory-heading">
            <header class="fv-maintenance-section-header">
                <div>
                    <p class="fv-eyebrow">Private archive inventory</p>
                    <h2 id="backup-inventory-heading">Available backups</h2>
                </div>
                <span class="fv-maintenance-count">{{ backupPagination.total }} {{ backupPagination.total == 1 ? 'archive' : 'archives' }}</span>
            </header>
            {% if backupPagination.total == 0 %}
                {% include '@platform_ui/components/empty_state.html.twig' with { eyebrow: 'No backups', headingId: 'backup-empty-heading', title: 'No completed backups yet', message: 'Create a manual or pre-upgrade backup to make a private recovery package.' } only %}
            {% else %}
                <div class="fv-table-container" tabindex="0" aria-label="Backup inventory table">
                    <table class="fv-table"><caption class="fv-visually-hidden">Private backup inventory</caption><thead><tr><th scope="col">Kind</th><th scope="col">Created</th><th scope="col">Schema</th><th scope="col">Size</th><th scope="col">Integrity</th><th scope="col">Actions</th></tr></thead><tbody>
                    {% for backup in backupPagination.items %}<tr><th scope="row">{{ backup.kind.label() }}</th><td><time datetime="{{ backup.createdAt|date('c') }}">{{ backup.createdAt|date('Y-m-d H:i:s T') }}</time></td><td>{{ backup.schemaVersion }}</td><td>{{ backup.sizeBytes|number_format(0, '.', ',') }} bytes</td><td><span class="fv-status-badge fv-status-badge-{{ backup.state.value == 'verified' ? 'success' : 'warning' }}">{{ backup.state.value|replace({'_': ' '})|title }}</span></td><td><div class="fv-table-actions">{% if backup.state.value == 'verified' %}<form method="post" action="{{ path('spoke_admin_backup_download', {backupId: backup.publicId}) }}"><input type="hidden" name="_token" value="{{ csrfToken }}"><button class="fv-button fv-button-secondary" type="submit">Download</button></form><button class="fv-button fv-button-danger" type="button" data-discovery-dialog-open="backup-delete-dialog-{{ backup.publicId }}" aria-haspopup="dialog"{% if backup.activeDownloads > 0 %} disabled{% endif %}>Delete</button>{% else %}<span class="fv-table-cell-note">No action available</span>{% endif %}</div></td></tr>{% endfor %}
                    </tbody></table>
                </div>
                {% include '@platform_ui/components/pagination.html.twig' with {
                    pages: backupPagination.pages,
                    total: backupPagination.total,
                    firstItem: backupPagination.firstItem,
                    lastItem: backupPagination.lastItem,
                    currentPage: backupPagination.page,
                    pageCount: backupPagination.pageCount,
                    pageParameter: backupPagination.pageParameter,
                    previous: backupPagination.previous,
                    next: backupPagination.next,
                    pageSizeControl: {action: path('spoke_admin_maintenance'), id: 'backup-page-size', name: 'backup_page_size', value: backupPagination.pageSize, options: [25, 50, 100], hidden: []}
                } only %}
                <p class="fv-maintenance-note">Deletion is permanent. A downloaded archive contains visitor submissions and private configuration.</p>
            {% endif %}
        </section>
        {% for backup in backupPagination.items %}
            {% if backup.state.value == 'verified' %}
                <section class="fv-modal fv-discovery-dialog" id="backup-delete-dialog-{{ backup.publicId }}" role="dialog" aria-modal="true" aria-labelledby="backup-delete-heading-{{ backup.publicId }}" data-discovery-dialog>
                    <div class="fv-modal-panel">
                        <header class="fv-modal-header"><div><p class="fv-eyebrow">Permanent action</p><h2 id="backup-delete-heading-{{ backup.publicId }}">Delete {{ backup.kind.label()|lower }} backup?</h2></div><button class="fv-icon-button" type="button" data-modal-close aria-label="Close delete confirmation">×</button></header>
                        <div class="fv-modal-body"><p class="fv-modal-description">This permanently removes the selected plain ZIP and its inventory record. It cannot be recovered from this installation.</p><dl class="fv-detail-list"><div><dt>Created</dt><dd>{{ backup.createdAt|date('Y-m-d H:i:s T') }}</dd></div><div><dt>Size</dt><dd>{{ backup.sizeBytes|number_format(0, '.', ',') }} bytes</dd></div></dl></div>
                        <footer class="fv-modal-footer"><button class="fv-button fv-button-secondary" type="button" data-modal-close>Cancel</button><form method="post" action="{{ path('spoke_admin_backup_delete', {backupId: backup.publicId}) }}"><input type="hidden" name="_token" value="{{ csrfToken }}"><input type="hidden" name="confirm_permanent" value="1"><button class="fv-button fv-button-danger" type="submit">Permanently delete</button></form></footer>
                    </div>
                </section>
            {% endif %}
        {% endfor %}
        <section class="fv-maintenance-system-grid" aria-label="Recovery and lifecycle controls">
            <article class="fv-maintenance-section" aria-labelledby="restore-instructions-heading">
                <header class="fv-section-heading">
                    <p class="fv-eyebrow">Hosting administrator</p>
                    <h2 id="restore-instructions-heading">Restore</h2>
                    <p>Restore is intentionally server-side. Validate an archive first, then run the restore command with explicit confirmation.</p>
                </header>
                <span class="fv-status-badge">Server-side operation</span>
            </article>
            <article class="fv-maintenance-section" aria-labelledby="retention-status-heading">
            <header class="fv-section-heading">
                <p class="fv-eyebrow">Retention and cleanup</p>
                <h2 id="retention-status-heading">Lifecycle status</h2>
                <p>Cleanup runs from the server scheduler. Records in Trash remain recoverable for at least seven full days.</p>
            </header>
            <div class="fv-maintenance-facts">
                <div><span>Scheduler</span><strong><span class="fv-status-badge fv-status-badge-{{ retentionSchedulerJob.severity }}">{{ retentionSchedulerJob.status|replace({'_': ' '})|title }}</span></strong></div>
                <div><span>Last run</span><strong>{{ retentionStatus.lastScanned }} scanned · {{ retentionStatus.lastDeleted }} deleted</strong></div>
                <div><span>Policy</span><strong>{{ retentionSettings.ordinaryRetentionDays }} / {{ retentionSettings.uncertainRetentionDays }} / {{ retentionSettings.auditRetentionDays }} days</strong></div>
            </div>
            <a class="fv-button fv-button-secondary fv-maintenance-inline-action" href="{{ path('spoke_admin_diagnostics') }}">View scheduler health</a>
            {% if retentionStatus.lastErrorCode %}
                <div class="fv-alert fv-alert-danger" role="alert"><strong>Last cleanup reported an error.</strong><span>Code: {{ retentionStatus.lastErrorCode }}. Review the server command output and run the task again after correcting the reported condition.</span></div>
            {% endif %}
            </article>
        </section>
    {% else %}
        {% include '@platform_ui/components/empty_state.html.twig' with {
            eyebrow: 'Feature area',
            headingId: 'destination-empty-heading',
            title: 'This area is ready for implementation',
            message: 'The shell and navigation are available. The feature behavior for this area belongs to a later approved unit.',
        } only %}
    {% endif %}
</div>
{% endblock %}
