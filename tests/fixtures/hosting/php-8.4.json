{
  "profile": "php-8.4-shared-vps",
  "php": "8.4",
  "required_extensions": [
    "ctype",
    "curl",
    "iconv",
    "mbstring",
    "openssl",
    "pdo_sqlite",
    "sodium",
    "zip"
